<svg xmlns="http://www.w3.org/2000/svg" width="1000" height="380" viewBox="0 0 1000 380" font-family="ui-monospace,'SF Mono',Menlo,Consolas,monospace">
  <defs>
    <clipPath id="clipP"><rect x="560" y="0" width="440" height="380"/></clipPath>
    <linearGradient id="scrimP" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#0d1117"/>
      <stop offset="0.6" stop-color="#0d1117" stop-opacity="0.45"/>
      <stop offset="1" stop-color="#0d1117" stop-opacity="0"/>
    </linearGradient>
    <linearGradient id="fadeP" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#0d1117" stop-opacity="0"/>
      <stop offset="1" stop-color="#0d1117"/>
    </linearGradient>
  </defs>

  <rect width="1000" height="380" fill="#0d1117"/>

  <!-- plum ink artwork, bleeding to the edge -->
  <g clip-path="url(#clipP)">
    <image href="@@ART_PLUM@@" x="560" y="0" width="440" height="380" preserveAspectRatio="xMidYMid slice"/>
    <rect x="560" y="0" width="240" height="380" fill="url(#scrimP)"/>
    <rect x="560" y="280" width="440" height="100" fill="url(#fadeP)"/>
  </g>

  <!-- left rail -->
  <line x1="42" y1="10" x2="42" y2="370" stroke="#1e1e22"/>
  <rect x="40.4" y="30" width="3.2" height="30" fill="#b3372c"/>
  <text x="24" y="330" font-size="10" letter-spacing="3" fill="#45454d" transform="rotate(-90 24 330)">PHILOSOPHY · <tspan font-family="'Songti SC','Noto Serif CJK SC','Source Han Serif SC',STSong,serif">道</tspan></text>

  <!-- quote -->
  <text x="96" y="128" font-family="Georgia,'Times New Roman',serif" font-size="46" fill="#e8e6e2">Systems should</text>
  <text x="96" y="186" font-family="Georgia,'Times New Roman',serif" font-size="46" fill="#e8e6e2">disappear when they</text>
  <text x="96" y="244" font-family="Georgia,'Times New Roman',serif" font-size="46" fill="#e8e6e2">become intuitive.</text>

  <rect x="96" y="284" width="52" height="3" fill="#b3372c"/>
  <text x="96" y="326" font-size="14" letter-spacing="1.5" fill="#7d7d85"><tspan font-family="'Songti SC','Noto Serif CJK SC','Source Han Serif SC',STSong,serif" font-size="17" fill="#b9b9c0">无为而无不为</tspan>&#160;&#160;wú wéi — act without forcing; nothing left undone.</text>
</svg>
